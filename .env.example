# 本地服务仅监听 127.0.0.1
PORT=4173
NODEX_DATA_DIR=./data

# AI 草稿，可选。使用支持 OpenAI Chat Completions 的模型服务。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# X OAuth 2.0，可选。在 X Developer Console 里登记完全相同的回调。
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:4173/api/x/callback


# Camoufox Profile Manager，可选。用其本机端口，留空禁用。
# 本机 8000 被占用时，可把 Manager 的 CPM_PORT 设为 8001，再填 8001。
CAMOUFOX_PORT=
CAMOUFOX_API_KEY=

# 生成页独立监听环回地址。登录码和会话保存在 SQLite。
NODEX_OPERATOR_PORT=4174
# 远端用 SSH 隧道时，这里填 Mac 本地映射端口（例如 7414）。
NODEX_OPERATOR_ACCESS_PORT=
# 由运维配置 scrypt$<32 字节盐的 hex>$<64 字节结果的 hex>。
NODEX_ADMIN_PASSWORD_HASH=
# 一次性设备登记令牌的 SHA-256 hex。
NODEX_ENROLLMENT_HASH=
# 通过同机反向代理公开工作台时，填写 HTTPS 来源（只到域名）。
NODEX_PUBLIC_ORIGIN=
