[Unit]
Description=Node X workbench and private operator service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=nodex
Group=nodex
WorkingDirectory=/opt/nodex/current
Environment=NODE_ENV=production
Environment=PORT=4173
Environment=NODEX_OPERATOR_PORT=4174
Environment=NODEX_OPERATOR_ACCESS_PORT=7414
Environment=NODEX_PUBLIC_ORIGIN=https://xai.chuhai7.com
Environment=NODEX_OPERATOR_PUBLIC_ORIGIN=https://xai.chuhai7.com
Environment=NODEX_DATA_DIR=/var/lib/nodex
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/nodex/ms-playwright
Environment=NODEX_X_PUBLISH_MODE=browser
EnvironmentFile=/etc/nodex/runtime.env
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
UMask=0077
StateDirectory=nodex
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nodex
SyslogIdentifier=nodex

[Install]
WantedBy=multi-user.target
